{
  "name": "cloudflare-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose up --build --wait",
    "dev:down": "docker compose down",
    "check": "npm run lint && npm run test:unit",
    "lint": "prettier --check . && npm run check:generated --workspace @factory/api-client && node packages/lint-rules/path-conventions.mjs && node --test \"packages/lint-rules/tests/**/*.test.mjs\" && eslint --config packages/lint-rules/eslint-manifests.config.mjs package.json \"apps/*/package.json\" \"packages/*/package.json\" --max-warnings 0 && oxlint --type-aware --type-check --deny-warnings && npm run lint:react-hooks && npm run lint:react-doctor",
    "test:unit": "tsx --test \"scripts/**/*.test.ts\" packages/platform/src/*.test.ts apps/*/src/*.test.ts",
    "test:e2e": "playwright test",
    "preview:deploy": "tsx scripts/preview/preview-cli.ts deploy",
    "preview:destroy": "tsx scripts/preview/preview-cli.ts destroy",
    "format": "prettier --write .",
    "lint:react-hooks": "node packages/lint-rules/node_modules/eslint/bin/eslint.js --config packages/lint-rules/eslint-react-hooks.config.mjs \"apps/frontend/src/**/*.{ts,tsx}\" --max-warnings 0 --no-inline-config",
    "lint:react-doctor": "tsx apps/frontend/scripts/node-check-react-doctor.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@cloudflare/workers-types": "5.20260907.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "react-doctor": "0.9.13",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "wrangler": "4.129.0"
  },
  "overrides": {
    "redis": "6.2.1",
    "@cloudflare/workers-types": "5.20260907.1"
  }
}
