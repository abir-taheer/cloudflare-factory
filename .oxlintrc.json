{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "react",
    "react-perf",
    "jsx-a11y",
    "node",
    "jsdoc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error",
    "nursery": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "denyWarnings": true,
    "maxWarnings": 0,
    "reportUnusedDisableDirectives": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "build/**",
    "apps/*/build/**",
    "packages/*/build/**",
    "**/coverage/**",
    "**/.wrangler/**",
    "**/.turbo/**",
    "**/worker-configuration.d.ts"
  ],
  "rules": {
    "no-console": "error",
    "no-nested-ternary": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["cloudflare:*", "@effect/platform-node", "@effect/platform-node/*"],
            "message": "Runtime packages belong in the documented Node or Worker entrypoint/adapter paths."
          },
          {
            "group": ["effect/Schema", "effect/Schema*", "effect/schema*"],
            "message": "Use Zod v4; Effect Schema imports are prohibited in every runtime and test."
          }
        ],
        "paths": [
          {
            "name": "effect",
            "importNames": ["flow", "Schema"],
            "message": "Use explicit Effect callbacks and Zod v4 schemas; flow and Effect Schema are prohibited."
          }
        ]
      }
    ],
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "checkThenables": true,
        "ignoreVoid": false,
        "ignoreIIFE": false
      }
    ],
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ],
    "new-cap": [
      "error",
      {
        "capIsNew": false
      }
    ],
    "one-var": ["error", "never"],
    "func-names": [
      "error",
      "as-needed",
      {
        "generators": "never"
      }
    ],
    "func-style": [
      "error",
      "declaration",
      {
        "allowArrowFunctions": true
      }
    ],
    "id-length": "off",
    "no-magic-numbers": [
      "error",
      {
        "ignore": [0, 1, -1],
        "ignoreArrayIndexes": true,
        "ignoreDefaultValues": true,
        "enforceConst": true
      }
    ],
    "no-ternary": "off",
    "no-undefined": "off",
    "no-underscore-dangle": "off",
    "sort-imports": [
      "error",
      {
        "ignoreDeclarationSort": true
      }
    ],
    "sort-keys": "off",
    "import/exports-last": "off",
    "import/group-exports": "off",
    "import/no-named-export": "off",
    "import/no-namespace": "off",
    "import/no-relative-parent-imports": "off",
    "import/prefer-default-export": "off",
    "oxc/no-optional-chaining": "off",
    "oxc/no-rest-spread-properties": "off",
    "typescript/explicit-function-return-type": "off",
    "typescript/explicit-module-boundary-types": "off",
    "typescript/no-extraneous-class": "off",
    "typescript/non-nullable-type-assertion-style": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/promise-function-async": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-null": "off",
    "unicorn/no-static-only-class": "off",
    "unicorn/prefer-global-this": "off",
    "unicorn/prefer-ternary": "off",
    "unicorn/throw-new-error": "off",
    "curly": ["error", "all"],
    "complexity": ["error", 20],
    "max-statements": ["error", 50],
    "max-lines-per-function": [
      "error",
      {
        "max": 100,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-params": ["error", 6],
    "unicorn/max-nested-calls": [
      "error",
      {
        "max": 8
      }
    ],
    "max-classes-per-file": ["error", 1],
    "prefer-destructuring": "off",
    "import/consistent-type-specifier-style": "off",
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "inline-type-imports"
      }
    ],
    "no-duplicate-imports": "off",
    "oxc/no-async-await": "off",
    "require-await": "off",
    "no-plusplus": [
      "error",
      {
        "allowForLoopAfterthoughts": true
      }
    ],
    "typescript/explicit-member-accessibility": [
      "error",
      {
        "accessibility": "no-public"
      }
    ],
    "typescript/parameter-properties": "off",
    "no-inline-comments": "off",
    "capitalized-comments": "off",
    "factory/no-conditional-log-level": "error",
    "factory/no-deprecated-zod-string-validators": "error",
    "factory/no-effect-run": "error",
    "factory/no-ignored-cause-callback": "error",
    "factory/no-immediate-returned-function-call": "error",
    "factory/no-inline-await-in-arguments": "error",
    "factory/no-inline-fallback-lambda": "error",
    "factory/no-inline-object-types": "error",
    "factory/no-inline-zod-in-create-route": "error",
    "factory/no-secret-material-in-logs": "error",
    "factory/no-tacit-effect-combinators": "error",
    "factory/no-try-in-effect-callback": "error",
    "factory/one-create-route-per-file": "error",
    "factory/zod-schema-const-names": "error",
    "factory/canonical-contract-imports": "error",
    "factory/require-schema-derived-contracts": "error",
    "factory/no-reannotated-auth-context": "error",
    "factory/no-unjustified-multiline-comments": "error",
    "factory/require-blank-lines-between-statement-types": "error",
    "factory/require-named-complex-conditions": "error",
    "factory/prefer-await-to-then": "error",
    "factory/prefer-await-to-callbacks": "error",
    "promise/prefer-await-to-then": "off",
    "promise/prefer-await-to-callbacks": "off",
    "factory/no-complex-ternary": "error",
    "factory/no-db-mocks": "error",
    "factory/no-unnecessary-spread": "error",
    "factory/no-type-casts": "error",
    "factory/no-error-message-expectations": "error",
    "factory/no-inline-generic-object-types": "error",
    "factory/brace-style": [
      "error",
      "1tbs",
      {
        "allowSingleLine": false
      }
    ],
    "factory/max-statements-per-line": [
      "error",
      {
        "max": 1
      }
    ],
    "react/jsx-filename-extension": [
      "error",
      {
        "extensions": [".jsx", ".tsx"]
      }
    ],
    "react/react-in-jsx-scope": "off",
    "react/forbid-component-props": [
      "error",
      {
        "forbid": ["style"]
      }
    ],
    "react/jsx-no-literals": "off",
    "jsdoc/require-param": "off",
    "jsdoc/require-returns": "off",
    "jsdoc/require-yields": "off",
    "jsdoc/require-param-type": "off",
    "jsdoc/require-property-type": "off",
    "jsdoc/require-returns-type": "off",
    "jsdoc/require-yields-type": "off",
    "node/no-sync": "off",
    "factory/no-sync-node-io": "error",
    "factory/no-effect-schema": "error"
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "rules": {
        "no-undef": "off"
      }
    },
    {
      "files": [
        "apps/*/src/node-*.ts",
        "packages/platform/src/adapters/**/*.ts",
        "scripts/**/*.ts",
        "apps/api/src/portable-configuration.ts"
      ],
      "env": {
        "node": true
      },
      "rules": {
        "import/no-nodejs-modules": "off",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["cloudflare:*"],
                "message": "Worker-only imports belong in Cloudflare adapters."
              },
              {
                "group": ["effect/Schema", "effect/Schema*", "effect/schema*"],
                "message": "Use Zod v4; Effect Schema imports are prohibited in every runtime and test."
              }
            ],
            "paths": [
              {
                "name": "effect",
                "importNames": ["flow", "Schema"],
                "message": "Use explicit Effect callbacks and Zod v4 schemas; flow and Effect Schema are prohibited."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/*/src/cloudflare-*.ts",
        "packages/platform/src/adapters/cloudflare*.ts",
        "packages/platform/src/adapters/r2-*.ts"
      ],
      "rules": {
        "import/no-nodejs-modules": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@effect/platform-node", "@effect/platform-node/*"],
                "message": "Cloudflare adapters cannot import the Node platform implementation."
              },
              {
                "group": ["effect/Schema", "effect/Schema*", "effect/schema*"],
                "message": "Use Zod v4; Effect Schema imports are prohibited in every runtime and test."
              }
            ],
            "paths": [
              {
                "name": "effect",
                "importNames": ["flow", "Schema"],
                "message": "Use explicit Effect callbacks and Zod v4 schemas; flow and Effect Schema are prohibited."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/*/src/cloudflare-*.ts"],
      "rules": {
        "import/no-default-export": "off",
        "import/no-anonymous-default-export": "off",
        "unicorn/no-anonymous-default-export": "off"
      }
    },
    {
      "files": [
        "packages/platform/src/adapters/**/*.ts",
        "apps/*/src/node-*.ts",
        "apps/*/src/cloudflare-*.ts",
        "scripts/**/*.ts"
      ],
      "rules": {
        "oxc/no-async-endpoint-handlers": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.spec.ts", "tests/**/*.ts", "**/*.test.mjs"],
      "env": {
        "node": true
      },
      "rules": {
        "import/no-nodejs-modules": "off",
        "typescript/no-floating-promises": [
          "error",
          {
            "checkThenables": true,
            "ignoreVoid": false,
            "ignoreIIFE": false,
            "allowForKnownSafeCalls": [
              {
                "from": "package",
                "package": "node:test",
                "name": ["test", "describe", "it", "suite"]
              }
            ]
          }
        ],
        "typescript/require-await": "off",
        "factory/no-error-message-assertions": "error",
        "factory/prefer-partial-deep-strict-equal": "error",
        "no-magic-numbers": "off",
        "node/no-process-env": "off"
      }
    },
    {
      "files": ["packages/platform/src/adapters/**/*.ts", "apps/*/src/cloudflare-*.ts"],
      "rules": {
        "typescript/method-signature-style": "off",
        "typescript/require-await": "off"
      }
    },
    {
      "files": [
        "packages/platform/src/adapters/**/*.ts",
        "scripts/**/*.ts",
        "apps/api/src/api-handler.ts"
      ],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["packages/platform/src/index.ts", "packages/platform/src/adapters/portable.ts"],
      "rules": {
        "oxc/no-barrel-file": "off",
        "unicorn/prefer-export-from": "off"
      }
    },
    {
      "files": ["playwright.config.ts"],
      "env": {
        "node": true
      },
      "rules": {
        "import/no-default-export": "off",
        "import/no-anonymous-default-export": "off"
      }
    },
    {
      "files": [
        "apps/*/src/node-*.ts",
        "apps/*/src/cloudflare-*.ts",
        "scripts/**/*-cli.ts",
        "**/*.test.ts",
        "**/*.spec.ts",
        "tests/**/*.ts"
      ],
      "rules": {
        "factory/no-effect-run": "off"
      }
    },
    {
      "files": ["packages/lint-rules/**/*.mjs"],
      "env": {
        "node": true
      },
      "rules": {
        "import/no-nodejs-modules": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/strict-boolean-expressions": "off",
        "typescript/strict-void-return": "off",
        "typescript/no-misused-promises": "off",
        "typescript/consistent-return": "off",
        "typescript/prefer-nullish-coalescing": "off",
        "no-continue": "off"
      }
    },
    {
      "files": ["packages/lint-rules/factory-lint-plugin.mjs"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["packages/lint-rules/tests/**/*.mjs"],
      "rules": {
        "no-template-curly-in-string": "off"
      }
    },
    {
      "files": ["apps/api/src/http/run-route-effect.ts"],
      "rules": {
        "factory/no-effect-run": "off"
      }
    },
    {
      "files": ["apps/api/src/routes/**/*.ts"],
      "rules": {
        "factory/no-untyped-api-routes": "error"
      }
    },
    {
      "files": ["packages/platform/src/adapters/migrate-postgres.ts"],
      "rules": {
        "factory/no-effect-run": "off"
      }
    },
    {
      "files": ["apps/api/src/api-configuration.ts", "apps/api/src/portable-configuration.ts"],
      "rules": {
        "factory/no-effect-run": "off"
      }
    },
    {
      "files": ["packages/auth/src/authentication-email.ts"],
      "rules": {
        "factory/no-effect-run": "off"
      }
    },
    {
      "files": ["apps/api/src/http/run-route-effect.ts"],
      "rules": {
        "factory/no-reannotated-auth-context": "off"
      }
    },
    {
      "files": [
        "packages/lint-rules/eslint-manifests.config.mjs",
        "packages/lint-rules/eslint-react-hooks.config.mjs"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": [
        "apps/*/src/node-*.ts",
        "scripts/**/*-cli.ts",
        "scripts/build/build-worker.ts",
        "packages/platform/src/adapters/migrate-postgres.ts"
      ],
      "rules": {
        "node/no-top-level-await": "off"
      }
    },
    {
      "files": ["packages/lint-rules/tests/**/*.mjs", "packages/lint-rules/path-conventions.mjs"],
      "rules": {
        "factory/no-sync-node-io": "off"
      }
    },
    {
      "files": ["packages/lint-rules/path-conventions.mjs"],
      "rules": {
        "node/no-top-level-await": "off"
      }
    },
    {
      "files": [
        "apps/executor/src/node-executor-configuration.ts",
        "scripts/preview/cloudflare/preview-command.ts",
        "scripts/preview/cloudflare/preview-hyperdrive.ts",
        "scripts/preview/preview-configuration.ts",
        "scripts/preview/preview-context.ts",
        "scripts/build/preview-build.ts",
        "playwright.config.ts"
      ],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": [
        "scripts/shared/deployment-doppler.ts",
        "scripts/preview/cloudflare/preview-cloudflare.ts",
        "scripts/shared/database/neon-api.ts",
        "scripts/preview/preview-github.ts",
        "scripts/shared/database/database-contract.ts",
        "scripts/preview/preview-cli.ts",
        "scripts/preview/database/preview-neon-cli.ts",
        "scripts/preview/database/preview-migrate-cli.ts",
        "scripts/build/production-artifacts-cli.ts"
      ],
      "rules": {
        "node/no-process-env": "off"
      }
    }
  ],
  "jsPlugins": [
    {
      "name": "factory",
      "specifier": "./packages/lint-rules/factory-lint-plugin.mjs"
    }
  ]
}
