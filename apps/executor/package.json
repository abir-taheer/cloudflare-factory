{
  "name": "@factory/executor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/node-executor.ts",
    "start": "node --import tsx dist/node-executor.js",
    "lint": "oxlint --type-aware --type-check --deny-warnings src",
    "build": "npm run build:node",
    "build:node": "esbuild src/node-executor.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/node-executor.js",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112",
    "zod": "4.5.4"
  }
}
